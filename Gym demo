<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>The Body Fox Gym & Wellness</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:Arial,Helvetica,sans-serif;
    background:#0b0b0b;
    color:#fff;
    line-height:1.6;
}

a{
    text-decoration:none;
    color:inherit;
}

/* NAVBAR */

.navbar{
    position:sticky;
    top:0;
    z-index:1000;
    background:#0b0b0b;
    border-bottom:1px solid #222;
    padding:18px 7%;
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.logo{
    font-size:22px;
    font-weight:900;
    letter-spacing:2px;
}

.logo span{
    color:#ff5a1f;
}

.nav-links{
    display:flex;
    gap:25px;
    list-style:none;
}

.nav-links a{
    color:#ddd;
    font-size:14px;
}

.nav-links a:hover{
    color:#ff5a1f;
}

.menu{
    display:none;
    font-size:25px;
}

/* HERO */

.hero{
    min-height:90vh;
    padding:100px 7%;
    display:flex;
    align-items:center;
    background:
    linear-gradient(90deg,rgba(0,0,0,.95),rgba(0,0,0,.65),rgba(0,0,0,.85)),
    linear-gradient(135deg,#242424,#111);
}

.hero-content{
    max-width:700px;
}

.small-title{
    color:#ff5a1f;
    font-size:13px;
    font-weight:bold;
    letter-spacing:4px;
    margin-bottom:18px;
}

.hero h1{
    font-size:clamp(48px,8vw,88px);
    line-height:1;
    text-transform:uppercase;
    margin-bottom:25px;
}

.hero h1 span{
    color:#ff5a1f;
}

.hero p{
    color:#ccc;
    max-width:600px;
    font-size:17px;
    margin-bottom:30px;
}

.btn{
    display:inline-block;
    padding:15px 25px;
    background:#ff5a1f;
    color:white;
    font-weight:bold;
    border-radius:4px;
    margin-right:10px;
    transition:.2s;
}

.btn:hover{
    transform:translateY(-2px);
    background:#e94d15;
}

.btn-outline{
    background:transparent;
    border:1px solid #555;
}

/* GENERAL */

section{
    padding:80px 7%;
}

.section-title{
    text-align:center;
    margin-bottom:45px;
}

.section-title .small-title{
    margin-bottom:8px;
}

.section-title h2{
    font-size:42px;
    text-transform:uppercase;
}

.section-title p{
    color:#999;
    margin-top:10px;
}

/* STATS */

.stats{
    background:#151515;
    display:grid;
    grid-template-columns:repeat(4,1fr);
    text-align:center;
}

.stat{
    padding:30px 10px;
    border-right:1px solid #292929;
}

.stat h3{
    color:#ff5a1f;
    font-size:38px;
}

.stat p{
    color:#aaa;
}

/* SERVICES */

.services{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:20px;
}

.service{
    background:#151515;
    padding:30px;
    border:1px solid #242424;
    border-radius:8px;
    transition:.2s;
}

.service:hover{
    transform:translateY(-5px);
    border-color:#ff5a1f;
}

.icon{
    font-size:38px;
    margin-bottom:15px;
}

.service h3{
    margin-bottom:10px;
    font-size:22px;
}

.service p{
    color:#999;
}

/* MEMBERSHIP */

.memberships{
    background:#111;
}

.plans{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:20px;
}

.plan{
    background:#181818;
    border:1px solid #292929;
    padding:35px;
    border-radius:8px;
    text-align:center;
}

.plan.featured{
    border:2px solid #ff5a1f;
    transform:scale(1.03);
}

.plan h3{
    font-size:25px;
}

.price{
    font-size:45px;
    font-weight:bold;
    margin:15px 0;
}

.price span{
    color:#999;
    font-size:15px;
}

.plan ul{
    list-style:none;
    text-align:left;
    margin:25px 0;
}

.plan li{
    padding:8px 0;
    color:#bbb;
}

.plan li::before{
    content:"✓ ";
    color:#ff5a1f;
    font-weight:bold;
}

/* TRAINERS */

.trainers{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:20px;
}

.trainer{
    background:#151515;
    border-radius:8px;
    overflow:hidden;
    border:1px solid #242424;
}

.trainer-photo{
    height:260px;
    background:linear-gradient(135deg,#333,#171717);
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:80px;
}

.trainer-info{
    padding:22px;
}

.trainer-info h3{
    font-size:22px;
}

.trainer-info p{
    color:#999;
}

/* FACILITIES */

.facilities{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:15px;
}

.facility{
    background:#151515;
    padding:25px;
    border-left:4px solid #ff5a1f;
}

.facility h3{
    margin-bottom:5px;
}

.facility p{
    color:#999;
}

/* GALLERY */

.gallery{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:12px;
}

.gallery-item{
    height:190px;
    background:linear-gradient(135deg,#3a3a3a,#171717);
    display:flex;
    justify-content:center;
    align-items:center;
    font-size:55px;
    border-radius:7px;
}

/* ABOUT */

.about{
    background:#151515;
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:50px;
    align-items:center;
}

.about h2{
    font-size:42px;
    margin-bottom:15px;
}

.about p{
    color:#aaa;
    margin-bottom:15px;
}

.check{
    margin:10px 0;
}

.check span{
    color:#ff5a1f;
    margin-right:8px;
}

/* CONTACT */

.contact{
    background:#101010;
}

.contact-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:40px;
}

.contact-box{
    background:#181818;
    padding:30px;
    border-radius:8px;
}

.contact-box h3{
    margin-bottom:20px;
}

.contact-item{
    margin:18px 0;
}

.contact-item strong{
    display:block;
    color:#ff5a1f;
}

.contact-item span{
    color:#bbb;
}

/* FORM */

form{
    display:flex;
    flex-direction:column;
    gap:14px;
}

input,
textarea,
select{
    width:100%;
    padding:14px;
    background:#0d0d0d;
    border:1px solid #333;
    color:white;
    border-radius:4px;
}

textarea{
    height:120px;
    resize:none;
}

button{
    border:none;
    cursor:pointer;
    padding:15px;
    background:#ff5a1f;
    color:white;
    font-weight:bold;
    border-radius:4px;
}

/* FOOTER */

footer{
    padding:30px 7%;
    text-align:center;
    background:#080808;
    color:#777;
}

footer strong{
    color:#ff5a1f;
}

/* MOBILE */

@media(max-width:800px){

    .nav-links{
        display:none;
    }

    .menu{
        display:block;
    }

    .hero{
        min-height:80vh;
        padding:70px 7%;
    }

    .stats{
        grid-template-columns:1fr 1fr;
    }

    .services,
    .plans,
    .trainers{
        grid-template-columns:1fr;
    }

    .plan.featured{
        transform:none;
    }

    .facilities,
    .about,
    .contact-grid{
        grid-template-columns:1fr;
    }

    .gallery{
        grid-template-columns:1fr 1fr;
    }

    .section-title h2{
        font-size:32px;
    }

}

</style>
</head>

